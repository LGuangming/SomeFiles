# Environment variables for Vercel Functions. Do not commit actual secrets.
# HTTPS URL returning the COMPLETE original Clash/Mihomo YAML (not a web page):
BASE_CONFIG_URL=https://example.com/path/to/base.yaml
# HTTPS URL returning Clash YAML with proxies:
SUBSCRIPTION_URL=https://example.com/subscribe?token=REPLACE_ME
# Random secret at least 24 chars (openssl rand -hex 32):
FEED_KEY=REPLACE_WITH_64_RANDOM_CHARACTERS
